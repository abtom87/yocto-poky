runqemu qemux86-64 tmp/deploy/images/qemux86-64/core-image-weston-qemux86-64.rootfs.qemuboot.conf  core-image-weston ext4 slirp nographic

runqemu tmp/deploy/images/qemux86-64/core-image-minimal-qemux86-64.rootfs.qemuboot.conf tmp/deploy/images/qemux86-64/core-image-minimal-qemux86-64.rootfs.ext4 slirp nographic

